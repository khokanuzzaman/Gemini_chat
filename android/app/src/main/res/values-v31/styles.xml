<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: splash_mark on brand indigo (#5647C4), the same
         in light and dark. Written for both qualifiers because a bare values-night
         would otherwise win over values-v31 on a dark-mode device. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

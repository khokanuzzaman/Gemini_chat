# Copy to `.env` (loaded automatically by Firebase Functions gen2 for all
# projects) or `.env.<projectId>` for per-project overrides.
#
# NOTE: OPENAI_API_KEY is NOT here — it is a Secret (see README "Secrets").

# OpenAI upstream (leave as default unless proxying a compatible endpoint).
OPENAI_BASE_URL=https://api.openai.com

# Timezone used to compute the daily/monthly usage bucket. MUST match the
# device timezone the app uses to write counters. Bangladesh audience -> Dhaka.
USAGE_TIMEZONE=Asia/Dhaka

# Global daily OpenAI spend cap in USD (overridable at runtime via the
# config/openai_proxy Firestore doc). Requests get 503 once the day is over cap.
DAILY_CAP_USD=10

# gpt-4o-mini pricing, USD per 1,000,000 tokens (update as prices change).
PRICE_IN_PER_M=0.15
PRICE_OUT_PER_M=0.60

# Flat USD charged per Whisper call against the spend cap (duration unknown in proxy).
WHISPER_FLAT_USD=0.01

# Enforce Firebase App Check. Auto-disabled under the emulator; keep true in prod.
ENFORCE_APP_CHECK=true

# Emulator only: return a canned response instead of calling OpenAI (no spend).
MOCK_OPENAI=false
